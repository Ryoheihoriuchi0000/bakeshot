import SwiftUI

// Bakeshot が入れる。撮影台本（Bakeshot/Scenes.swift）から使う道具立て。
// **このファイルは編集しないでください。** 台本は Bakeshot/Scenes.swift に書きます。

/// 絵の大きさ。既定は端末の画面（`bakeshot bake --device` で決まる）。
/// ウィジェットは画面ではないので、寸法を明示する。
public enum BakeshotSize {
    case phone                 // 端末の画面。ノッチと Home バーのセーフエリアが入る
    case widgetSmall           // 170 × 170
    case widgetMedium          // 364 × 170
    case widgetLarge           // 364 × 382
    case widgetExtraLarge      // 715 × 382（iPad）
    case custom(CGFloat, CGFloat)

    var points: CGSize? {
        switch self {
        case .phone:            return nil
        case .widgetSmall:      return CGSize(width: 170, height: 170)
        case .widgetMedium:     return CGSize(width: 364, height: 170)
        case .widgetLarge:      return CGSize(width: 364, height: 382)
        case .widgetExtraLarge: return CGSize(width: 715, height: 382)
        case .custom(let w, let h): return CGSize(width: w, height: h)
        }
    }
    var isPhone: Bool { if case .phone = self { return true }; return false }
}

/// 1 枚の絵。名前・ライト/ダーク・大きさ・中身。
public struct BakeshotScene {
    public let name: String
    public let dark: Bool
    public let size: BakeshotSize
    public let body: () -> AnyView
}

/// 台本の 1 行を作る。
/// - Parameters:
///   - name: 書き出すファイル名（言語ごとのフォルダに入る）
///   - dark: ダークモードで焼くか
@MainActor
public func shot<V: View>(_ name: String, dark: Bool = false, size: BakeshotSize = .phone,
                          @ViewBuilder _ body: @escaping () -> V) -> BakeshotScene {
    BakeshotScene(name: name, dark: dark, size: size, body: { AnyView(body()) })
}

/// ライトとダークを 1 行で並べる（`_light` / `_dark` が名前に付く）。
@MainActor
public func shotBoth<V: View>(_ name: String, size: BakeshotSize = .phone,
                              @ViewBuilder _ body: @escaping () -> V) -> [BakeshotScene] {
    [shot("\(name)_light", dark: false, size: size, body),
     shot("\(name)_dark", dark: true, size: size, body)]
}

/// いま焼いている言語（"ja" / "en" など）。台本の中で見せる文言を出し分けたい時に使う。
public enum Bakeshot {
    public static var locale: String {
        ProcessInfo.processInfo.environment["BAKESHOT_LOCALE"]
            ?? (Locale.preferredLanguages.first.map { String($0.prefix(2)) } ?? "ja")
    }
    public static var isJa: Bool { locale.hasPrefix("ja") }
    /// 言語で出し分ける。`Bakeshot.L("記録", "Track")`
    public static func L(_ ja: String, _ en: String) -> String { isJa ? ja : en }
}
